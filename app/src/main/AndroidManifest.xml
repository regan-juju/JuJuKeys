<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Microphone permission: requested at runtime, only used when the mic button is tapped explicitly -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JuJuKeys"
        android:usesCleartextTraffic="false">

        <!-- Launcher activity: onboarding / "enable keyboard" instructions + entry point to Settings -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.JuJuKeys">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full Settings screen, also reachable from the in-keyboard Settings toolbar button -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/Theme.JuJuKeys" />

        <!-- Transparent activity used only to request the RECORD_AUDIO runtime permission
             on behalf of the keyboard service (a Service cannot request permissions itself). -->
        <activity
            android:name=".voice.MicPermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <!-- The real Android system keyboard service -->
        <service
            android:name=".JuJuKeysInputMethodService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

    </application>

</manifest>
